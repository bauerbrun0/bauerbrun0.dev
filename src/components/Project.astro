---
import ArrowUpRight from "@assets/icons/ArrowUpRight.astro";
import GitHub from "@assets/icons/GitHub.astro";
import Link from "@components/Link.astro";

interface Props {
  title: string;
  description: string;
  link: string;
  type: "github" | "live";
  wip?: boolean;
}

const { title, description, link, type, wip = false }: Props = Astro.props;
---

<div>
  <div class="flex items-center gap-1.5">
    <Link href={link} target="_blank">
      <div class="flex w-fit items-center gap-1.5">
        <span>{title}</span>
        {type === "github" ? <GitHub classes="w-4 h-4" /> : <ArrowUpRight classes="w-4 h-4" />}
      </div>
    </Link>
    {wip && (
      <span
        class={`
            inline-flex items-center rounded-md border border-amber-500/30 bg-amber-500/10
            px-1.5 py-0.5 text-[10px] leading-none font-semibold tracking-wide text-amber-700 dark:text-amber-400
          `}
      >
        WIP
      </span>
    )}
  </div>
  <p class="mt-2 mb-0! text-sm text-gray-600 md:mt-2 md:text-base dark:text-gray-400">
    {description}
  </p>
</div>
