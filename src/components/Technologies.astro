---
interface Props {
  technologies: string[];
  name: string;
}

const { technologies, name }: Props = Astro.props;
---

<h2 class="text-xs font-medium text-gray-600 md:text-sm dark:text-gray-400">{name}</h2>
<div class="flex flex-wrap gap-x-3 gap-y-1 md:gap-x-4 md:gap-y-2">
  {technologies.map((technology) => (
    <span>{technology}</span>
  ))}
</div>
